# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bizmate

# Frontend server-side API calls
BACKEND_API_URL=http://localhost:8000

# Azure AI Projects
AZURE_AI_PROJECT_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT

# Azure AI Agents
AZURE_TAX_AGENT_NAME=tax-saving-ai
AZURE_TAX_AGENT_VERSION=3
AZURE_SUPPORT_AGENT_NAME=support-program-ai
AZURE_SUPPORT_AGENT_VERSION=2
AZURE_PORTFOLIO_AGENT_NAME=generate-portfolio-ai
AZURE_PORTFOLIO_AGENT_VERSION=2

# Azure OpenAI Chat Completions
# Authentication uses DefaultAzureCredential / Managed Identity.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-10-21
